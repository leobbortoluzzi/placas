{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tag-redirect",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-13",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // Keep dashboard-only vars/secrets (e.g. SUPABASE_SERVICE_ROLE_KEY)
  // so a git deploy does not wipe what you set in the Cloudflare UI.
  "keep_vars": true,
  // Public config. Values here are sent on every deploy.
  // Do NOT put the service_role key here — it would overwrite the dashboard secret.
  "vars": {
    "FALLBACK_URL": "https://luzzi.dev",
    "DEFAULT_BUSINESS": "Luzzi.Dev",
    "TAG_ID_PATTERN": "^[0-9A-Fa-f]{8,20}$",
    "SUPABASE_URL": "https://mipnlysqagmcgkiraxjv.supabase.co"
  }
  // SUPABASE_SERVICE_ROLE_KEY: add in the dashboard as Type = Secret
  // (or: wrangler secret put SUPABASE_SERVICE_ROLE_KEY)
  //
  // Custom domain: wrangler domains add tag.luzzi.dev
}
