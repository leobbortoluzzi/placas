{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tag-redirect",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-13",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // Public config (not secrets). Override per env if needed.
  "vars": {
    "FALLBACK_URL": "https://luzzi.dev",
    "DEFAULT_BUSINESS": "Luzzi.Dev",
    // NFC UID only: 8–20 hex chars. Words like wp-json / habib never match.
    "TAG_ID_PATTERN": "^[0-9A-Fa-f]{8,20}$"
  }
  // Secrets (set via CLI, never commit):
  //   wrangler secret put SUPABASE_URL
  //   wrangler secret put SUPABASE_SERVICE_ROLE_KEY
  //
  // Custom domain (after deploy):
  //   wrangler domains add tag.luzzi.dev
  // or attach route in dashboard: tag.luzzi.dev/*
}
